# Pinned inputs for the runtime bundle. Sourced by the build scripts and the workflow.
# Change a value here (and bump BASE_REVISION when the base layer changes) to roll a new base.

# proot (GPL-2.0-or-later), built from source with the Android NDK.
PROOT_REPO=https://github.com/termux/proot
PROOT_COMMIT=52d65a4dc140ca554d241a1438ddd4f6b00c9813
PROOT_VERSION=5.1.107.102
# SHA-256 of $PROOT_REPO/archive/$PROOT_COMMIT.tar.gz
PROOT_SRC_SHA256=895867fce973f050e51f09b949f8a995ce62f4a28be119c791ff0fef3b2cf2b0
# Compiled-in loader directory. It never exists: the app always sets PROOT_LOADER.
PROOT_UNBUNDLE_LOADER=/proot-loader-is-set-by-PROOT_LOADER

# talloc (LGPL-3.0-or-later), linked statically into proot.
TALLOC_VERSION=2.5.0
TALLOC_SHA256=912afa237510ae542a7733998eb18a12bcda35ab6729c8e2ddb43e8d0ebab007

# Android NDK used for proot, and the API level it targets (the app's minSdk).
NDK_VERSION=28.2.13676358
ANDROID_API=26

# Debian base.
DEBIAN_SUITE=trixie
DEBIAN_SNAPSHOT=20261110T000000Z
DEBIAN_PACKAGES=bash,coreutils,ca-certificates,curl,git,openssh-client,less,procps,tar,gzip,xz-utils,zstd,ripgrep

# Node.js (official build from nodejs.org), installed at /opt/node.
NODE_VERSION=24.22.3

# pnpm, installed through the Node.js corepack at build time and kept in /opt/corepack, so the
# phone needs no network the first time it runs. The harness installs plugins with `pnpm`.
# pnpm 12 downloads its native binary on first run; the build runs it once to fetch that too.
PNPM_VERSION=12.23.0

# Bump when the base layer recipe changes without a version change above.
BASE_REVISION=2
